        .chat-send-btn { min-width: 82px; font-weight: 700; }
        .admin-amount-shortcuts { display: flex; flex-wrap: wrap; gap: 7px; margin: -2px 0 12px; }
        .admin-amount-shortcuts button {
            padding: 6px 10px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: rgba(97, 217, 206, .08);
            color: #c8f1ed;
            font: inherit;
            font-size: .78rem;
            cursor: pointer;
        }

        @media (max-width: 900px) {
            .container { grid-template-columns: 1fr; }
            .community-layout { grid-template-columns: 1fr; }
            .online-list { max-height: 220px; }
        }

        @media (max-width: 600px) {
            body { padding: 10px; }
            .header { border-radius: 18px; }
            .tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .tab-btn { padding: 10px 8px; font-size: .78rem; }
