            const rand = Math.random();
            
            const chances = { ...PROBABILITIES };
            const rareKeys = ['epic', 'legendary', 'mythic', 'prismatic', 'secret', 'cosmic', 'divine'];
            const commonKeys = ['common', 'uncommon', 'rare'];
            
            rareKeys.forEach(k => {
                if (typeof chances[k] !== 'number' || isNaN(chances[k])) chances[k] = 0;
                chances[k] *= luck;
            });
            
            const newRareSum = rareKeys.reduce((s, k) => s + chances[k], 0);
            const oldCommonSum = commonKeys.reduce((s, k) => s + (chances[k] || 0), 0);
            const targetCommonSum = Math.max(0, 1 - newRareSum);
            
            if (oldCommonSum > 0) {
                const factor = targetCommonSum / oldCommonSum;
                commonKeys.forEach(k => { chances[k] = (chances[k] || 0) * factor; });
            }
            
            const total = Object.values(chances).reduce((a, b) => a + b, 0);
            if (total <= 0 || isNaN(total)) return 'common';
            for (let k in chances) chances[k] /= total;
            
            let cum = 0;
            for (let r of ['common', 'uncommon', 'rare', 'epic', 'legendary', 'mythic', 'prismatic', 'secret', 'cosmic', 'divine']) {
                cum += chances[r] || 0;
                if (rand < cum) return r;
            }
            return 'common';
        }

        function pickCaseRarity(caseItem) {
            const entries = Object.entries(caseItem.weights || {}).filter(([, weight]) => Number.isFinite(weight) && weight > 0);
            const total = entries.reduce((sum, [, weight]) => sum + weight, 0);
            if (!total) return caseItem.rewards[Math.floor(Math.random() * caseItem.rewards.length)];
            let roll = Math.random() * total;
            for (const [rarity, weight] of entries) {
                roll -= weight;
                if (roll < 0) return rarity;
            }
            return entries[entries.length - 1][0];
        }

        function spinPhone() {
            if (isSpinning) return;
            const cost = getSpinCost();
            if (gameData.balance < cost) { notify('Недостаточно денег!'); return; }

            isSpinning = true;
            const btn = document.getElementById('spinBtn');
            const display = document.getElementById('spinDisplay');
            btn.disabled = true;
            display.classList.remove('empty');
            display.innerHTML = '<div style="font-size: 2em; color: #e74c3c;">⚡ КРУТИМ...</div>';
            display.classList.add('spinning');

            setTimeout(() => {
                gameData.balance -= cost;
                const rarity = getRarity();
                const phone = PHONES[rarity].phones[Math.floor(Math.random() * PHONES[rarity].phones.length)];
                if (['prismatic', 'secret', 'cosmic', 'divine'].includes(rarity)) {
                    window.publishRareDrop?.(rarity, phone);
                }

                gameData.collection.push({ phone, rarity, price: PHONES[rarity].price });
                gameData.totalSpins++;

                const reward = Math.floor(REWARDS[rarity] * getIncomeMultiplier());
                if (reward > 0) {
                    gameData.balance += reward;
                    gameData.totalProfit += reward;
                    notify(`+${reward.toLocaleString()} за ${PHONES[rarity].name}`);
                }

                display.classList.remove('spinning');
                const rInfo = PHONES[rarity];
                const stars = '⭐'.repeat(rInfo.rating);
                
                display.innerHTML = `
                    <div class="phone-rarity rarity-${rarity}">// ${rInfo.name}</div>
                    <div class="phone-photo">${getPhoneSVG(phone, rarity, 90)}</div>
                    <div class="phone-name rarity-${rarity}">${phone}</div>
                    <div class="rating-stars">${stars}</div>
                    <div class="price-display rarity-${rarity}">💰 ${rInfo.price.toLocaleString()}</div>
                `;

                playSound(rarity === 'secret' ? 1200 : 600);
                saveGame();
                updateUI();
                isSpinning = false;
                btn.disabled = false;
            }, SPIN_DELAY);
        }

        function openCase(caseIndex) {
            if (isCaseAnimating) return;
            const caseItem = CASES[caseIndex];
            const finalPrice = Math.floor(caseItem.price * (1 - getDiscount()));

            if (gameData.balance < finalPrice) { notify('Недостаточно денег!'); return; }

            isCaseAnimating = true;
            gameData.balance -= finalPrice;

            const winRarity = pickCaseRarity(caseItem);
            const winPhone = PHONES[winRarity].phones[Math.floor(Math.random() * PHONES[winRarity].phones.length)];
            const winPrice = PHONES[winRarity].price;
            if (['prismatic', 'secret', 'cosmic', 'divine'].includes(winRarity)) {
                window.publishRareDrop?.(winRarity, winPhone);
            }

            gameData.collection.push({ phone: winPhone, rarity: winRarity, price: winPrice });
            gameData.totalSpins++;
            gameData.casesOpened++;

            const reward = Math.floor(REWARDS[winRarity] * getIncomeMultiplier());
            if (reward > 0) {
                gameData.balance += reward;
                gameData.totalProfit += reward;
            }

            saveGame();
            updateUI();

            document.getElementById('caseModal').classList.add('show');
            document.getElementById('caseOpeningTitle').textContent = '📦 ' + caseItem.name;
            document.getElementById('caseResultBox').style.display = 'none';
            document.getElementById('caseLoading').style.display = 'block';

            const ITEM_WIDTH = 140;
            const WINNER_IDX = Math.floor(Math.random() * 8) + 50;
            const TOTAL_ITEMS = 65;

            let stripHTML = '';
            for (let i = 0; i < TOTAL_ITEMS; i++) {
                let r, p;
                if (i === WINNER_IDX) {
                    r = winRarity;
                    p = winPhone;
                } else {
                    r = pickCaseRarity(caseItem);
                    p = PHONES[r].phones[Math.floor(Math.random() * PHONES[r].phones.length)];
                }
                stripHTML += `
                    <div class="case-item ${r}">
                        ${getPhoneSVG(p, r, 55)}
                        <div class="case-item-name rarity-${r}">${p}</div>
                    </div>
                `;
            }

            const strip = document.getElementById('caseStrip');
            strip.innerHTML = stripHTML;
            strip.style.transition = 'none';
            strip.style.transform = 'translateX(0px)';
            void strip.offsetWidth;

            caseStartTimer = setTimeout(() => {
                caseStartTimer = null;
                const viewport = document.getElementById('caseViewport');
                const viewportWidth = viewport.offsetWidth;
                const targetCenter = WINNER_IDX * ITEM_WIDTH + ITEM_WIDTH / 2;
                const randomOffset = (Math.random() - 0.5) * 60;
                const finalTranslate = -(targetCenter - viewportWidth / 2 + randomOffset);

                strip.style.transition = 'transform 6s cubic-bezier(0.15, 0.85, 0.25, 1)';
                strip.style.transform = `translateX(${finalTranslate}px)`;

                let tickCount = 0;
                caseTickInterval = setInterval(() => {
                    if (tickCount >= 30) {
                        clearInterval(caseTickInterval);
                        caseTickInterval = null;
                        return;
                    }
                    playSound(800 - tickCount * 15, 0.03);
                    tickCount++;
                }, 180);

                caseResultTimer = setTimeout(() => {
                    caseResultTimer = null;
                    if (!document.getElementById('caseModal').classList.contains('show')) return;
                    document.getElementById('caseLoading').style.display = 'none';
                    const rInfo = PHONES[winRarity];
                    const stars = '⭐'.repeat(rInfo.rating);

                    document.getElementById('caseResultContent').innerHTML = `
                        <div class="phone-rarity rarity-${winRarity}" style="font-size: 1.4em;">// ${rInfo.name}</div>
                        <div class="phone-photo" style="margin: 20px 0;">${getPhoneSVG(winPhone, winRarity, 120)}</div>
                        <div class="case-result-name rarity-${winRarity}">${winPhone}</div>
                        <div class="rating-stars">${stars}</div>
                        <div class="case-result-price">💰 ${winPrice.toLocaleString()}</div>
                    `;

                    document.getElementById('caseResult').className = 'case-result ' + winRarity;
                    document.getElementById('caseResultBox').style.display = 'block';

                    playSound(winRarity === 'divine' ? 1600 : winRarity === 'cosmic' ? 1450 : winRarity === 'secret' ? 1350 : winRarity === 'prismatic' ? 1200 : 800, 0.4);
                    isCaseAnimating = false;
                }, 6200);
            }, 300);
        }

        function closeCaseModal() {
            if (caseStartTimer !== null) clearTimeout(caseStartTimer);
            if (caseResultTimer !== null) clearTimeout(caseResultTimer);
            if (caseTickInterval !== null) clearInterval(caseTickInterval);
            caseStartTimer = null;
            caseResultTimer = null;
            caseTickInterval = null;
            isCaseAnimating = false;
            document.getElementById('caseLoading').style.display = 'none';
            document.getElementById('caseResultBox').style.display = 'none';
            document.getElementById('caseModal').classList.remove('show');
            updateUI();
        }

        function buyUpgrade(upgradeId) {
            const upg = UPGRADES.find(u => u.id === upgradeId);
            if (!upg) return;
            if (hasUpgrade(upgradeId)) { notify('Уже куплено!'); return; }
            if (gameData.balance < upg.price) { notify('Недостаточно денег!'); return; }

            gameData.balance -= upg.price;
            if (!gameData.upgrades) gameData.upgrades = {};
            gameData.upgrades[upgradeId] = true;
            saveGame();
            updateUI();
            notify(`✅ Куплено: ${upg.name}`);
            playSound(1000, 0.3);
        }

        function dailyBonus() {
            if (bonusToday) { notify('Бонус уже получен сегодня'); return; }
            gameData.balance += 500000;
            bonusToday = true;
            localStorage.setItem('bonusToday', new Date().toDateString());
            saveGame();
            updateUI();
            notify('+500,000 бонус!');
            document.getElementById('bonusBtn').disabled = true;
        }

        function sellPhone(idx) {
            const item = gameData.collection[idx];
            gameData.balance += item.price;
            gameData.collection.splice(idx, 1);
            saveGame();
            updateUI();
            notify(`Продано за ${item.price.toLocaleString()}`);
        }

        function sellAll() {
            if (gameData.collection.length === 0) return;
            const total = gameData.collection.reduce((s, i) => s + i.price, 0);
            gameData.balance += total;
            gameData.collection = [];
            saveGame();
            updateUI();
            notify(`Продано за ${total.toLocaleString()}`);
        }

        function updateUI() {
            document.getElementById('balance').textContent = gameData.balance.toLocaleString();
            document.getElementById('profit').textContent = gameData.totalProfit.toLocaleString();
            document.getElementById('spins').textContent = gameData.totalSpins;
            document.getElementById('casesOpened').textContent = gameData.casesOpened;
            document.getElementById('divineCount').textContent = gameData.collection.filter(i => i.rarity === 'divine').length;
            document.getElementById('cosmicCount').textContent = gameData.collection.filter(i => i.rarity === 'cosmic').length;
            document.getElementById('secretCount').textContent = gameData.collection.filter(i => i.rarity === 'secret').length;
            document.getElementById('prismaticCount').textContent = gameData.collection.filter(i => i.rarity === 'prismatic').length;
            document.getElementById('mythicCount').textContent = gameData.collection.filter(i => i.rarity === 'mythic').length;
            document.getElementById('legendaryCount').textContent = gameData.collection.filter(i => i.rarity === 'legendary').length;
            
            document.getElementById('luckDisplay').textContent = 'x' + getLuckMultiplier().toFixed(2);
            document.getElementById('incomeDisplay').textContent = 'x' + getIncomeMultiplier().toFixed(2);

            updateGarage();
            updateCases();
            updateUpgrades();
            updateStats();

            if (bonusToday) document.getElementById('bonusBtn').disabled = true;
        }

        function updateGarage() {
            const rarities = ['divine', 'cosmic', 'secret', 'prismatic', 'mythic', 'legendary', 'epic', 'rare', 'uncommon', 'common'];
            let html = '';

            if (gameData.collection.length === 0) {
                html = '<div class="empty-msg">// Гараж пуст, начни крутить!</div>';
            } else {
                html = '<div class="garage-grid">';
                const shown = new Set();

                for (let r of rarities) {
                    const items = gameData.collection.filter(i => i.rarity === r);
                    for (let i = 0; i < items.length; i++) {
                        const item = items[i];
                        const key = item.phone + r;
                        if (!shown.has(key)) {
                            shown.add(key);
                            const count = items.filter(x => x.phone === item.phone).length;
                            const idx = gameData.collection.findIndex(x => x.phone === item.phone && x.rarity === r);
                            
                            html += `
                                <div class="garage-card">
                                    <div class="phone-svg-wrapper">${getPhoneSVG(item.phone, r, 70)}</div>
                                    <div class="garage-name rarity-${r}">${item.phone}</div>
                                    <div class="garage-rarity rarity-${r}">${PHONES[r].name}</div>
                                    <div class="garage-count">×${count}</div>
                                    <div class="garage-price">${item.price.toLocaleString()}</div>
                                    <button class="sell-btn" onclick="sellPhone(${idx})">ПРОДАТЬ</button>
                                </div>
                            `;
                        }
                    }
                }
                html += '</div>';
            }
            document.getElementById('garageContainer').innerHTML = html;
        }

        function updateCases() {
            let html = '';
            const discount = getDiscount();
            CASES.forEach((c, idx) => {
                const finalPrice = Math.floor(c.price * (1 - discount));
                const canBuy = gameData.balance >= finalPrice;

                html += `
                    <div class="shop-card case-shop-card case-${c.rarity}">
                        <div class="case-card-header">
                            <span class="case-tier-pill rarity-${c.rarity}">${PHONES[c.rarity].name}</span>
                            <span class="case-edition">СЕРИЯ ${String(idx + 1).padStart(2, '0')}</span>
                        </div>
                        <div class="case-crate" aria-hidden="true">${c.emoji}</div>
                        <div class="shop-name">${c.name}</div>
                        <div class="case-card-desc">${c.description}</div>
                        <div class="case-reward-label">Внутри может быть</div>
                        <div class="case-reward-list">${c.rewards.map(r => `<span class="case-reward-chip rarity-${r}">${PHONES[r].name}</span>`).join('')}</div>
                        <div class="case-price-row">
                            <span class="case-price-label">Цена</span>
                            <div class="shop-price">💰 ${finalPrice.toLocaleString()}${discount > 0 ? `<span class="case-original-price">${c.price.toLocaleString()}</span>` : ''}</div>
                        </div>
                        <button type="button" class="shop-btn case-open-btn" onclick="openCase(${idx})" ${!canBuy ? 'disabled' : ''}>${canBuy ? 'ОТКРЫТЬ КЕЙС' : 'НЕДОСТАТОЧНО МОНЕТ'}</button>
                    </div>
                `;
            });
            document.getElementById('casesContainer').innerHTML = html;
        }

        function updateUpgrades() {
            let html = '';
            UPGRADES.forEach(u => {
                const owned = hasUpgrade(u.id);
                const canBuy = !owned && gameData.balance >= u.price;
                
                html += `
                    <div class="shop-card ${owned ? 'owned' : ''}">
                        ${owned ? '<div class="owned-badge">✅ КУПЛЕНО</div>' : ''}
                        <div class="shop-icon">${u.icon}</div>
                        <div class="shop-name">${u.name}</div>
                        <div class="shop-desc">${u.desc}</div>
                        <div class="shop-price">💰 ${u.price.toLocaleString()}</div>
                        <button class="shop-btn ${owned ? 'owned-btn' : ''}" 
                                onclick="${!owned && canBuy ? `buyUpgrade('${u.id}')` : ''}"
                                ${!canBuy && !owned ? 'disabled' : ''}>
                            ${owned ? 'КУПЛЕНО' : canBuy ? 'КУПИТЬ' : 'МАЛО ДЕНЕГ'}
                        </button>
                    </div>
                `;
            });
            document.getElementById('upgradesContainer').innerHTML = html;
        }

        function updateStats() {
            const rarities = ['divine', 'cosmic', 'secret', 'prismatic', 'mythic', 'legendary', 'epic', 'rare', 'uncommon', 'common'];
            let html = '';

            for (let r of rarities) {
                const items = gameData.collection.filter(i => i.rarity === r);
                if (items.length === 0) continue;

                html += `
                    <div class="rarity-section">
                        <div class="rarity-header rarity-${r}">
                            <span>// ${PHONES[r].name}</span>
                            <span>${items.length} шт</span>
                        </div>
                        <div class="rarity-items">
                `;

                const unique = [...new Set(items.map(i => i.phone))];
                for (let phone of unique) {
                    const count = items.filter(i => i.phone === phone).length;
                    const idx = gameData.collection.findIndex(i => i.phone === phone && i.rarity === r);
                    
                    html += `
                        <div class="item">
                            <div class="item-info">
                                <div style="width: 40px;">${getPhoneSVG(phone, r, 30)}</div>
                                <span class="item-name rarity-${r}">${phone}</span>
                                <span class="item-count">×${count}</span>
                            </div>
                            <button class="sell-btn" style="width: auto; padding: 6px 12px;" onclick="sellPhone(${idx})">💸</button>
                        </div>
                    `;
                }
                html += '</div></div>';
            }

            if (html === '') html = '<div class="empty-msg">// Нет телефонов</div>';
            document.getElementById('statsContainer').innerHTML = html;
        }

        function switchTab(tab, button) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tab).classList.add('active');
            const activeButton = button || document.querySelector(`.tab-btn[data-tab="${tab}"]`);
            activeButton?.classList.add('active');
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            localStorage.setItem('soundEnabled', soundEnabled);
            document.getElementById('soundStatus').textContent = soundEnabled ? 'ВКЛ' : 'ВЫКЛ';
            notify(`Звук ${soundEnabled ? 'включен' : 'отключен'}`);
        }

        function resetAllData() {
            if (!confirm('Удалить все данные?')) return;
            gameData = { balance: 1000000, collection: [], totalSpins: 0, totalProfit: 0, casesOpened: 0, upgrades: {} };
            bonusToday = false;
            localStorage.removeItem('bonusToday');
            saveGame();
            updateUI();
            notify('Данные очищены');
        }

        function openAdminPanel() {
            if (!window.isAdmin) { notify('Доступ запрещен'); return; }
            loadProbs();
            const modal = document.getElementById('adminModal');
            if (!modal.classList.contains('show')) {
                window.adminPreviousBodyOverflow = document.body.style.overflow;
                document.body.style.overflow = 'hidden';
            }
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            document.getElementById('adminBalance').value = gameData.balance;
            document.getElementById('delayInput').value = SPIN_DELAY;
            
            document.getElementById('commonSlider').value = (PROBABILITIES.common * 100).toFixed(2);
            document.getElementById('uncommonSlider').value = (PROBABILITIES.uncommon * 100).toFixed(2);
            document.getElementById('rareSlider').value = (PROBABILITIES.rare * 100).toFixed(2);
            document.getElementById('epicSlider').value = (PROBABILITIES.epic * 100).toFixed(2);
            document.getElementById('legendarySlider').value = (PROBABILITIES.legendary * 100).toFixed(2);
            document.getElementById('mythicSlider').value = (PROBABILITIES.mythic * 100).toFixed(2);
            document.getElementById('prismaticSlider').value = (PROBABILITIES.prismatic * 100).toFixed(2);
            document.getElementById('secretSlider').value = (PROBABILITIES.secret * 100).toFixed(2);
            document.getElementById('cosmicSlider').value = (PROBABILITIES.cosmic * 100).toFixed(2);
            document.getElementById('divineSlider').value = (PROBABILITIES.divine * 100).toFixed(2);
            
            updateProbs();
            window.updateGiveHistory?.();
            window.setTimeout(() => document.getElementById('adminRecipient')?.focus(), 40);
        }

        function closeAdminPanel() {
            const modal = document.getElementById('adminModal');
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = window.adminPreviousBodyOverflow || '';
        }

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && document.getElementById('adminModal')?.classList.contains('show')) {
                closeAdminPanel();
            }
        });

        function addMoneyToPlayer(amount) {
            if (!amount || amount <= 0) { notify('Введи корректное число!'); return; }
            gameData.balance += amount;
            saveGame();
            updateUI();
            notify(`✅ Себе выдано ${amount.toLocaleString()}`);
            document.getElementById('customMoney').value = '';
        }

        function setBalance() {
            const val = parseInt(document.getElementById('adminBalance').value);
            if (val >= 0) {
                gameData.balance = val;
                saveGame();
                updateUI();
                notify('✅ Баланс: ' + val.toLocaleString());
            }
        }

        function updateProbs() {
            const vals = {
                common: +document.getElementById('commonSlider').value,
                uncommon: +document.getElementById('uncommonSlider').value,
                rare: +document.getElementById('rareSlider').value,
                epic: +document.getElementById('epicSlider').value,
                legendary: +document.getElementById('legendarySlider').value,
                mythic: +document.getElementById('mythicSlider').value,
                prismatic: +document.getElementById('prismaticSlider').value,
                secret: +document.getElementById('secretSlider').value,
                cosmic: +document.getElementById('cosmicSlider').value,
                divine: +document.getElementById('divineSlider').value
            };

            const total = Object.values(vals).reduce((a, b) => a + b);
            const factor = total > 0 ? 100 / total : 1;

            for (let key in vals) {
                document.getElementById(key + 'Val').textContent = (vals[key] * factor).toFixed(2) + '%';
            }
            window.tempProbs = vals;
            window.tempFactor = factor;
        }

        function saveProbabilities() {
            updateProbs();
            const f = window.tempFactor / 100;
            PROBABILITIES = {
                common: window.tempProbs.common * f,
                uncommon: window.tempProbs.uncommon * f,
                rare: window.tempProbs.rare * f,
                epic: window.tempProbs.epic * f,
                legendary: window.tempProbs.legendary * f,
                mythic: window.tempProbs.mythic * f,
                prismatic: window.tempProbs.prismatic * f,
                secret: window.tempProbs.secret * f,
                cosmic: window.tempProbs.cosmic * f,
                divine: window.tempProbs.divine * f
            };
            localStorage.setItem('probs', JSON.stringify(PROBABILITIES));
            notify('✅ Вероятности сохранены');
        }

        function resetProbabilities() {
            PROBABILITIES = { ...DEFAULT_PROBABILITIES };
            localStorage.setItem('probs', JSON.stringify(PROBABILITIES));
            document.getElementById('commonSlider').value = 44.8;
            document.getElementById('uncommonSlider').value = 20;
            document.getElementById('rareSlider').value = 15;
            document.getElementById('epicSlider').value = 12;
            document.getElementById('legendarySlider').value = 5;
            document.getElementById('mythicSlider').value = 2;
            document.getElementById('prismaticSlider').value = 0.7;
            document.getElementById('secretSlider').value = 0.3;
            document.getElementById('cosmicSlider').value = 0.15;
            document.getElementById('divineSlider').value = 0.05;
            updateProbs();
            notify('✅ Default OK');
        }

        function setDelay() {
            SPIN_DELAY = parseInt(document.getElementById('delayInput').value);
            notify('✅ Задержка: ' + SPIN_DELAY + 'мс');
        }

        function notify(msg) {
            const n = document.createElement('div');
            n.className = 'notification';
            n.textContent = msg;
            document.body.appendChild(n);
            setTimeout(() => n.remove(), 2500);
        }

        checkAdmin();
        loadProbs();
        updateUI();
    </script>
