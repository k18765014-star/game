        function loadProbs() {
            const saved = localStorage.getItem('probs');
            if (!saved) {
                PROBABILITIES = { ...DEFAULT_PROBABILITIES };
                return;
            }
            
            try {
                const parsed = JSON.parse(saved);
                const merged = { ...DEFAULT_PROBABILITIES };
                for (const key of Object.keys(DEFAULT_PROBABILITIES)) {
                    if (Number.isFinite(parsed[key]) && parsed[key] >= 0) merged[key] = parsed[key];
                }
                const sum = Object.values(merged).reduce((a, b) => a + b, 0);
                PROBABILITIES = sum > 0
                    ? Object.fromEntries(Object.entries(merged).map(([key, value]) => [key, value / sum]))
                    : { ...DEFAULT_PROBABILITIES };
                localStorage.setItem('probs', JSON.stringify(PROBABILITIES));
            } catch (e) {
                PROBABILITIES = { ...DEFAULT_PROBABILITIES };
                localStorage.setItem('probs', JSON.stringify(PROBABILITIES));
            }
        }

        function playSound(freq = 600, dur = 0.15) {
            if (!soundEnabled) return;
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.3, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + dur);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + dur);
            } catch (e) {}
        }

