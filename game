<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ВЫБЕЙ СВОЙ ТЕЛЕФОН!</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Courier New', monospace;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: #e0e0e0;
            overflow-x: hidden;
            padding: 15px;
            min-height: 100vh;
        }

        .wrapper { max-width: 100%; margin: 0 auto; }

        .header {
            text-align: center;
            margin-bottom: 30px;
            padding: 40px 20px;
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border-radius: 10px;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #fff, transparent);
            animation: shine 2s infinite;
        }

        @keyframes shine { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }

        h1 {
            font-size: 3.2em;
            color: #fff;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
            letter-spacing: 2px;
            margin-bottom: 8px;
        }

        .subtitle { font-size: 1.1em; color: rgba(255, 255, 255, 0.9); letter-spacing: 1px; }

        .container {
            display: grid;
            grid-template-columns: 1fr 1.5fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .panel {
            background: linear-gradient(135deg, #2a2a3e 0%, #1f1f2e 100%);
            border-radius: 8px;
            padding: 25px;
            border: 1px solid #e74c3c;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.2);
        }

        .panel-title {
            font-size: 1.2em;
            color: #e74c3c;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 10px;
        }

        .balance-display {
            font-size: 2.5em;
            color: #3498db;
            text-align: center;
            margin: 20px 0;
            font-weight: bold;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(231, 76, 60, 0.2);
        }

        .info-label { color: #999; }
        .info-value { color: #3498db; font-weight: bold; }

        .spin-display {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 2px solid #e74c3c;
            padding: 40px 20px;
            text-align: center;
            min-height: 280px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
            border-radius: 8px;
        }

        .spin-display.empty { color: #666; font-size: 1.3em; }

        @keyframes spinAnim {
            0% { transform: rotateY(0) rotateZ(-5deg); }
            50% { transform: rotateY(180deg) rotateZ(5deg) scale(1.1); }
            100% { transform: rotateY(360deg) rotateZ(-5deg); }
        }

        .spin-display.spinning { animation: spinAnim 0.5s ease-in-out; }

        .phone-photo {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 15px 0;
            filter: drop-shadow(0 0 12px rgba(52, 152, 219, 0.4));
            animation: pulse 0.6s ease-in-out;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.08); }
        }

        .phone-svg { display: block; }
        .phone-svg-wrapper { display: flex; justify-content: center; align-items: center; }

        .phone-rarity {
            font-size: 1.2em;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .phone-name { font-size: 1.6em; font-weight: bold; margin-bottom: 15px; }

        .rarity-common { color: #808080; }
        .rarity-uncommon { color: #0099ff; }
        .rarity-rare { color: #9933ff; }
        .rarity-epic { color: #ff9900; }
        .rarity-legendary { color: #ff0000; }
        .rarity-mythic { color: #ff1493; }
        .rarity-cosmic {
            color: #80e4ff;
            text-shadow: 0 0 10px rgba(70, 185, 255, .8), 0 0 24px rgba(100, 75, 255, .5);
            font-weight: 900;
        }
        .rarity-divine {
            color: #ffe7a3;
            background: linear-gradient(110deg, #fff3c4, #e4ad45, #fff7d8, #bd822d);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 18px rgba(255, 211, 112, .35);
            animation: divineShine 3s linear infinite;
            font-weight: 900;
        }
        @keyframes divineShine { to { background-position: 200% center; } }

        .rarity-prismatic {
            background: linear-gradient(135deg, #FF0000, #FF7F00, #FFFF00, #00FF00, #00FFFF, #0000FF, #8B00FF);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: rainbowMove 2s ease infinite;
            font-weight: 900;
        }

        @keyframes rainbowMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .rarity-secret {
            color: #fff;
            text-shadow: 0 0 10px #fff, 0 0 20px #fff, 0 0 30px #ff00ff, 0 0 40px #ff00ff;
            animation: secretGlow 1.5s ease-in-out infinite;
            font-weight: 900;
            letter-spacing: 3px;
        }

        @keyframes secretGlow {
            0%, 100% { text-shadow: 0 0 10px #fff, 0 0 20px #fff, 0 0 30px #ff00ff, 0 0 40px #ff00ff; filter: brightness(1); }
            50% { text-shadow: 0 0 15px #fff, 0 0 30px #fff, 0 0 45px #ff00ff, 0 0 60px #ff00ff; filter: brightness(1.4); }
        }

        .rating-stars { font-size: 1.2em; margin: 10px 0; }

        .price-display {
            font-size: 1.3em;
            font-weight: bold;
            margin-top: 10px;
        }

        .button-group { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 15px; }

        .btn {
            padding: 15px 20px;
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 1.05em;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
            transition: all 0.3s;
            font-family: 'Courier New', monospace;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
        }

        .btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(231, 76, 60, 0.5); }
        .btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .btn-full { grid-column: 1 / -1; }

        .btn-blue { background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3); }
        .btn-blue:hover:not(:disabled) { box-shadow: 0 6px 20px rgba(52, 152, 219, 0.5); }

        .btn-gold { background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%); box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3); }
        .btn-gold:hover:not(:disabled) { box-shadow: 0 6px 20px rgba(243, 156, 18, 0.5); }

        .btn-green { background: linear-gradient(135deg, #27ae60 0%, #229954 100%); box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3); }
        .btn-green:hover:not(:disabled) { box-shadow: 0 6px 20px rgba(39, 174, 96, 0.5); }

        .tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 30px; }

        .tab-btn {
            padding: 12px;
            background: linear-gradient(135deg, #2a2a3e 0%, #1f1f2e 100%);
            border: 1px solid #e74c3c;
            border-radius: 6px;
            color: #999;
            text-transform: uppercase;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            transition: all 0.2s;
            font-size: 0.9em;
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border-color: #e74c3c;
            color: #fff;
        }

        .tab-btn:hover:not(.active) { border-color: #3498db; color: #3498db; }

        .tab-content {
            display: none;
            background: linear-gradient(135deg, #2a2a3e 0%, #1f1f2e 100%);
            border-radius: 8px;
            padding: 25px;
            border: 1px solid #e74c3c;
        }

        .tab-content.active { display: block; animation: fadeIn 0.3s; }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .content-title {
            font-size: 1.5em;
            color: #e74c3c;
            margin-bottom: 20px;
            text-transform: uppercase;
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 10px;
            font-weight: bold;
        }

        .section-title {
            font-size: 1.2em;
            color: #f39c12;
            margin: 25px 0 15px 0;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
            border-bottom: 2px solid #f39c12;
            padding-bottom: 8px;
        }

        .section-title:first-child { margin-top: 0; }

        .garage-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
        }

        .garage-card {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 2px solid #3498db;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s;
        }

        .garage-card:hover {
            box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
            transform: translateY(-5px);
            border-color: #e74c3c;
        }

        .garage-name { font-size: 0.9em; color: #3498db; margin: 8px 0; font-weight: bold; }
        .garage-rarity { font-size: 0.8em; color: #999; margin-bottom: 8px; }

        .garage-count {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: #fff;
            padding: 4px 8px;
            display: inline-block;
            margin-bottom: 8px;
            font-weight: bold;
            border-radius: 4px;
        }

        .garage-price { font-size: 0.85em; color: #e74c3c; margin-bottom: 8px; font-weight: bold; }

        .sell-btn {
            width: 100%;
            padding: 6px;
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            border-radius: 4px;
            color: #fff;
            cursor: pointer;
            font-size: 0.9em;
            font-weight: bold;
            font-family: 'Courier New', monospace;
        }

        .sell-btn:hover { transform: scale(1.05); }

        .shop-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
        }

        .shop-card {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 2px solid #f39c12;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s;
            position: relative;
        }

        .shop-card.owned {
            border-color: #27ae60;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
        }

        .shop-card:hover {
            box-shadow: 0 8px 25px rgba(243, 156, 18, 0.5);
            transform: translateY(-5px);
        }

        .shop-card.owned:hover {
            box-shadow: 0 8px 25px rgba(39, 174, 96, 0.5);
        }

        .case-shop-card {
            --case-accent: #84a0b5;
            --case-glow: rgba(132, 160, 181, .18);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 365px;
            padding: 17px;
            border: 1px solid var(--case-accent);
            border-radius: 18px;
            background:
                radial-gradient(ellipse at 50% 25%, var(--case-glow), transparent 62%),
                linear-gradient(155deg, rgba(255,255,255,.065), transparent 35%),
                linear-gradient(145deg, #172438, #0d1522 76%);
            box-shadow: inset 0 1px rgba(255,255,255,.09), 0 12px 30px rgba(0,0,0,.2);
            text-align: left;
            transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
        }
        .case-shop-card:hover {
            transform: translateY(-5px);
            border-color: #fff;
            box-shadow: inset 0 1px rgba(255,255,255,.14), 0 18px 40px var(--case-glow);
        }
        .case-shop-card.case-rare { --case-accent: #ba83ff; --case-glow: rgba(153, 51, 255, .25); }
        .case-shop-card.case-epic { --case-accent: #ffb45d; --case-glow: rgba(255, 153, 0, .22); }
        .case-shop-card.case-legendary { --case-accent: #ff777f; --case-glow: rgba(255, 51, 75, .22); }
        .case-shop-card.case-mythic { --case-accent: #ff81cf; --case-glow: rgba(255, 20, 147, .24); }
        .case-shop-card.case-prismatic { --case-accent: #e19cff; --case-glow: rgba(193, 70, 255, .28); }
        .case-shop-card.case-secret { --case-accent: #f4efff; --case-glow: rgba(220, 207, 255, .25); }
        .case-shop-card.case-cosmic { --case-accent: #72d8ff; --case-glow: rgba(53, 147, 255, .3); }
        .case-shop-card.case-divine { --case-accent: #ffe09a; --case-glow: rgba(255, 193, 76, .32); }
        .case-card-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
        .case-tier-pill, .case-edition {
            padding: 5px 8px;
            border: 1px solid color-mix(in srgb, var(--case-accent) 48%, transparent);
            border-radius: 999px;
            background: rgba(0, 0, 0, .24);
            font-size: .66rem;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .case-edition { color: #98a9bd; font-variant-numeric: tabular-nums; }
        .case-crate {
            display: grid;
            place-items: center;
            width: 82px;
            height: 82px;
            margin: 15px auto 3px;
            border: 1px solid color-mix(in srgb, var(--case-accent) 55%, transparent);
            border-radius: 25px;
            background: radial-gradient(circle, rgba(255,255,255,.13), transparent 72%);
            box-shadow: 0 0 32px var(--case-glow), inset 0 0 18px rgba(255,255,255,.06);
            font-size: 2.6rem;
            filter: drop-shadow(0 6px 16px var(--case-glow));
        }
        .case-shop-card .shop-name { margin: 8px 0 5px; color: #f2f5fb; font-size: 1rem; text-align: center; }
        .case-card-desc { min-height: 34px; margin: 0 0 12px; color: #aab8ca; font-size: .75rem; line-height: 1.45; text-align: center; }
        .case-reward-label { margin-bottom: 6px; color: #8092a9; font-size: .65rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
        .case-reward-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; min-height: 45px; margin-bottom: 12px; }
        .case-reward-chip { padding: 4px 7px; border: 1px solid rgba(255,255,255,.1); border-radius: 999px; background: rgba(255,255,255,.035); font-size: .64rem; }
        .case-price-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 11px; border-top: 1px solid rgba(255,255,255,.1); }
        .case-price-label { color: #8092a9; font-size: .72rem; }
        .case-shop-card .shop-price { margin: 0; color: var(--case-accent); font-size: 1rem; white-space: nowrap; }
        .case-original-price { margin-left: 5px; color: #748198; font-size: .7rem; font-weight: 500; text-decoration: line-through; }
        .case-open-btn { margin-top: 11px; border: 1px solid color-mix(in srgb, var(--case-accent) 55%, transparent); border-radius: 10px; background: linear-gradient(135deg, color-mix(in srgb, var(--case-accent) 27%, #172438), #172438); color: #f5f7fb; }
        .case-open-btn:hover:not(:disabled) { border-color: var(--case-accent); box-shadow: 0 0 18px var(--case-glow); }
        .case-open-btn:disabled { opacity: .45; background: #172033; color: #8491a2; }

        .shop-icon { font-size: 50px; margin: 10px 0; }
        .shop-name { font-size: 1.1em; color: #f39c12; margin: 12px 0; font-weight: bold; text-transform: uppercase; }
        .shop-desc { font-size: 0.9em; color: #aaa; margin-bottom: 12px; min-height: 40px; }
        .shop-price { font-size: 1.2em; color: #3498db; font-weight: bold; margin-bottom: 15px; }

        .shop-btn {
            width: 100%;
            padding: 10px;
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            border: none;
            border-radius: 4px;
            color: #fff;
            cursor: pointer;
            font-weight: bold;
            font-family: 'Courier New', monospace;
            text-transform: uppercase;
        }

        .shop-btn:hover:not(:disabled) { transform: scale(1.05); }
        .shop-btn:disabled { opacity: 0.5; cursor: not-allowed; }

        .shop-btn.owned-btn {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            cursor: default;
        }

        .owned-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #27ae60;
            color: #fff;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75em;
            font-weight: bold;
            text-transform: uppercase;
        }

        .rarity-section { margin-bottom: 25px; }

        .rarity-header {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 2px solid #3498db;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            text-transform: uppercase;
            font-weight: bold;
        }

        .rarity-items { display: flex; flex-direction: column; gap: 8px; }

        .item {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 1px solid #3498db;
            border-radius: 4px;
            padding: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .item-info { display: flex; gap: 12px; align-items: center; flex: 1; }
        .item-name { color: #3498db; font-weight: bold; flex: 1; }
        .item-count { background: rgba(52, 152, 219, 0.2); padding: 2px 8px; border-radius: 3px; font-size: 0.9em; }

        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }

        .stat-box {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 2px solid #3498db;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }

        .stat-name { font-size: 0.85em; color: #999; margin-bottom: 8px; text-transform: uppercase; }
        .stat-num { font-size: 1.8em; color: #3498db; font-weight: bold; }

        .admin-input {
            width: 100%;
            padding: 12px;
            background: #1a1a2e;
            border: 1px solid #3498db;
            border-radius: 6px;
            color: #3498db;
            margin-bottom: 12px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            font-size: 1em;
        }

        .admin-input:focus {
            border-color: #e74c3c;
            outline: none;
            box-shadow: 0 0 10px rgba(52, 152, 219, 0.3);
        }

        .slider-container {
            margin-bottom: 20px;
            padding: 15px;
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 1px solid #3498db;
            border-radius: 6px;
        }

        .slider-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            color: #3498db;
            font-weight: bold;
            font-size: 0.95em;
            text-transform: uppercase;
        }

        .slider {
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg, #3498db, #e74c3c);
            outline: none;
            -webkit-appearance: none;
            appearance: none;
            cursor: pointer;
            border-radius: 3px;
        }

        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 16px;
            height: 16px;
            background: #e74c3c;
            cursor: pointer;
            border-radius: 50%;
        }

        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: #fff;
            padding: 16px 25px;
            text-transform: uppercase;
            font-weight: bold;
            z-index: 3000;
            animation: slideIn 0.3s;
            border-radius: 6px;
            max-width: 400px;
        }

        @keyframes slideIn { from { transform: translateX(400px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

        .empty-msg { text-align: center; color: #666; padding: 40px; font-size: 1.2em; }

        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.9);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            padding: 20px;
            backdrop-filter: blur(4px);
        }

        .modal.show { display: flex; }

        .modal-box {
            background: linear-gradient(135deg, #2a2a3e 0%, #1f1f2e 100%);
            border: 2px solid #e74c3c;
            padding: 40px;
            max-width: 700px;
            width: 100%;
            border-radius: 10px;
            max-height: 90vh;
            overflow-y: auto;
            animation: popIn 0.3s;
            position: relative;
        }

        @keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        .modal-title {
            font-size: 2em;
            color: #e74c3c;
            margin-bottom: 25px;
            text-transform: uppercase;
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 15px;
            font-weight: bold;
        }

        .close-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #e74c3c;
            border: none;
            color: #fff;
            width: 40px;
            height: 40px;
            font-size: 1.5em;
            cursor: pointer;
            border-radius: 4px;
        }

        .close-btn:hover { background: #c0392b; }

        .admin-only {
            color: #e74c3c;
            text-align: center;
            padding: 20px;
            background: rgba(231, 76, 60, 0.1);
            border: 2px solid #e74c3c;
            border-radius: 6px;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .admin-section {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 1px solid #3498db;
            border-radius: 6px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .admin-section-title {
            font-size: 1.2em;
            color: #f39c12;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
            border-bottom: 2px solid #f39c12;
            padding-bottom: 8px;
        }

        .money-preset {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
            gap: 8px;
            margin-bottom: 15px;
        }

        .money-btn {
            padding: 10px 8px;
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            border: none;
            color: #fff;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.85em;
            transition: all 0.2s;
            font-family: 'Courier New', monospace;
            text-transform: uppercase;
        }

        .money-btn:hover { transform: scale(1.05); box-shadow: 0 4px 12px rgba(39, 174, 96, 0.4); }

        /* CASE OPENING */
        .case-opening-box {
            background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
            border: 2px solid #f39c12;
            border-radius: 12px;
            padding: 30px 25px;
            max-width: 800px;
            width: 100%;
            max-height: calc(100vh - 24px);
            max-height: calc(100dvh - 24px);
            overflow-y: auto;
            overscroll-behavior: contain;
            box-shadow: 0 20px 60px rgba(243, 156, 18, 0.4);
            animation: popIn 0.4s;
            text-align: center;
        }

        .case-modal-close {
            position: fixed;
            top: max(12px, env(safe-area-inset-top));
            right: max(12px, env(safe-area-inset-right));
            z-index: 3001;
            width: 42px;
            height: 42px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.45);
            color: #fff;
            font-size: 1.6em;
            line-height: 1;
            cursor: pointer;
            display: grid;
            place-items: center;
        }

        .case-modal-close:hover {
            background: rgba(231, 76, 60, 0.9);
        }

        .case-opening-title {
            font-size: 1.5em;
            color: #f39c12;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .case-viewport {
            position: relative;
            width: 100%;
            height: 200px;
            overflow: hidden;
            background: linear-gradient(180deg, #0a0a1a 0%, #1a1a2e 100%);
            border-radius: 10px;
            border: 2px solid #f39c12;
            margin-bottom: 25px;
            box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.8);
        }

        .case-viewport::before, .case-viewport::after {
            content: '';
            position: absolute;
            top: 0; bottom: 0;
            width: 80px;
            z-index: 5;
            pointer-events: none;
        }

        .case-viewport::before { left: 0; background: linear-gradient(90deg, #0a0a1a 0%, transparent 100%); }
        .case-viewport::after { right: 0; background: linear-gradient(-90deg, #0a0a1a 0%, transparent 100%); }

        .case-pointer {
            position: absolute;
            top: 0; bottom: 0;
            left: 50%;
            width: 4px;
            background: linear-gradient(180deg, transparent 0%, #ff0000 20%, #ff0000 80%, transparent 100%);
            z-index: 10;
            transform: translateX(-50%);
            box-shadow: 0 0 25px #ff0000, 0 0 50px rgba(255, 0, 0, 0.5);
            animation: pointerPulse 1s ease-in-out infinite;
        }

        @keyframes pointerPulse {
            0%, 100% { box-shadow: 0 0 25px #ff0000, 0 0 50px rgba(255, 0, 0, 0.5); }
            50% { box-shadow: 0 0 35px #ff0000, 0 0 70px rgba(255, 0, 0, 0.7); }
        }

        .case-strip {
            display: flex;
            position: absolute;
            top: 0; left: 0;
            height: 100%;
            align-items: center;
            gap: 8px;
            padding: 0 20px;
            will-change: transform;
        }

        .case-item {
            flex-shrink: 0;
            width: 132px;
            height: 170px;
            background: linear-gradient(135deg, #1e1e2e 0%, #2a2a3e 100%);
            border: 2px solid #333;
            border-radius: 8px;
            padding: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .case-item.common { border-color: #808080; box-shadow: 0 0 15px rgba(128, 128, 128, 0.3); }
        .case-item.uncommon { border-color: #0099ff; box-shadow: 0 0 15px rgba(0, 153, 255, 0.4); }
        .case-item.rare { border-color: #9933ff; box-shadow: 0 0 15px rgba(153, 51, 255, 0.4); }
        .case-item.epic { border-color: #ff9900; box-shadow: 0 0 15px rgba(255, 153, 0, 0.5); }
        .case-item.legendary { border-color: #ff0000; box-shadow: 0 0 20px rgba(255, 0, 0, 0.6); }
        .case-item.mythic { border-color: #ff1493; box-shadow: 0 0 22px rgba(255, 20, 147, 0.7); }

        .case-item.prismatic {
            border: 2px solid transparent;
            background: linear-gradient(135deg, #1e1e2e 0%, #2a2a3e 100%) padding-box,
                        linear-gradient(135deg, #FF0000, #FF7F00, #FFFF00, #00FF00, #00FFFF, #0000FF, #8B00FF) border-box;
            box-shadow: 0 0 25px rgba(255, 0, 255, 0.7);
        }

        .case-item.secret {
            border-color: #fff;
            background: linear-gradient(135deg, #000 0%, #0a0a0a 100%);
            box-shadow: 0 0 25px #fff, 0 0 50px rgba(255, 255, 255, 0.5);
            animation: secretItemPulse 1s infinite;
        }

        .case-item.cosmic {
            border-color: #72d8ff;
            background: radial-gradient(circle at 50% 10%, rgba(89, 149, 255, .35), transparent 60%), linear-gradient(150deg, #08152e, #171039);
            box-shadow: 0 0 24px rgba(53, 147, 255, .5);
        }
        .case-item.divine {
            border-color: #ffe09a;
            background: radial-gradient(circle at 50% 10%, rgba(255, 220, 137, .28), transparent 60%), linear-gradient(150deg, #2b2111, #17151a);
            box-shadow: 0 0 28px rgba(255, 193, 76, .52);
        }

        @keyframes secretItemPulse {
            0%, 100% { box-shadow: 0 0 25px #fff, 0 0 50px rgba(255, 255, 255, 0.5); }
            50% { box-shadow: 0 0 40px #fff, 0 0 80px rgba(255, 255, 255, 0.8); }
        }

        .case-item-name {
            font-size: 0.7em;
            text-align: center;
            margin-top: 5px;
            font-weight: bold;
            line-height: 1.1;
        }

        .case-loading {
            color: #f39c12;
            font-size: 1.2em;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: bold;
            margin-bottom: 20px;
            animation: blink 1s infinite;
        }

        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

        .case-result {
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 100%);
            border: 2px solid #f39c12;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 20px;
            animation: resultSlide 0.5s ease-out;
        }

        @keyframes resultSlide {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .case-result.common { border-color: #808080; }
        .case-result.uncommon { border-color: #0099ff; box-shadow: 0 0 30px rgba(0, 153, 255, 0.3); }
        .case-result.rare { border-color: #9933ff; box-shadow: 0 0 30px rgba(153, 51, 255, 0.4); }
        .case-result.epic { border-color: #ff9900; box-shadow: 0 0 30px rgba(255, 153, 0, 0.5); }
        .case-result.legendary { border-color: #ff0000; box-shadow: 0 0 40px rgba(255, 0, 0, 0.6); animation: legendaryResult 1s infinite; }
        .case-result.mythic { border-color: #ff1493; box-shadow: 0 0 45px rgba(255, 20, 147, 0.7); }

        .case-result.prismatic {
            border: 2px solid transparent;
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 100%) padding-box,
                        linear-gradient(135deg, #FF0000, #FF7F00, #FFFF00, #00FF00, #00FFFF, #0000FF, #8B00FF) border-box;
            box-shadow: 0 0 40px rgba(255, 0, 255, 0.6);
            animation: prismaticResult 2s infinite;
        }

        @keyframes prismaticResult {
            0%, 100% { filter: hue-rotate(0deg); }
            100% { filter: hue-rotate(360deg); }
        }

        .case-result.secret {
            border-color: #fff;
            background: linear-gradient(135deg, #000 0%, #0a0a0a 100%);
            box-shadow: 0 0 50px #fff, 0 0 100px rgba(255, 255, 255, 0.4);
            animation: secretResult 1.5s infinite;
        }

        .case-result.cosmic {
            border-color: #72d8ff;
            background: radial-gradient(circle at 50% 0, rgba(66, 137, 255, .24), transparent 55%), linear-gradient(145deg, #07152b, #15102d);
            box-shadow: 0 0 50px rgba(53, 147, 255, .52), inset 0 0 32px rgba(115, 218, 255, .08);
        }
        .case-result.divine {
            border-color: #ffe09a;
            background: radial-gradient(circle at 50% 0, rgba(255, 219, 139, .18), transparent 58%), linear-gradient(145deg, #2c2110, #17151a);
            box-shadow: 0 0 54px rgba(255, 193, 76, .52), inset 0 0 32px rgba(255, 235, 179, .08);
        }

        @keyframes secretResult {
            0%, 100% { box-shadow: 0 0 50px #fff, 0 0 100px rgba(255, 255, 255, 0.4); }
            50% { box-shadow: 0 0 80px #fff, 0 0 150px rgba(255, 255, 255, 0.7); }
        }

        @keyframes legendaryResult {
            0%, 100% { box-shadow: 0 0 40px rgba(255, 0, 0, 0.6); }
            50% { box-shadow: 0 0 60px rgba(255, 0, 0, 0.9); }
        }

        .case-result-name { font-size: 1.5em; font-weight: bold; margin: 12px 0; }
        .case-result-price { font-size: 1.3em; color: #f39c12; font-weight: bold; margin-top: 10px; }

        .case-close-btn {
            padding: 14px 40px;
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 1.1em;
            cursor: pointer;
            text-transform: uppercase;
            font-weight: bold;
            font-family: 'Courier New', monospace;
        }

        .case-close-btn:hover { transform: scale(1.05); }

        @media (max-width: 1200px) {
            .container { grid-template-columns: 1fr; }
            .tabs { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 600px) {
            h1 { font-size: 1.8em; }
            .balance-display { font-size: 1.8em; }
            .button-group { grid-template-columns: 1fr; }
            .tabs { grid-template-columns: 1fr; }
            .stats-grid { grid-template-columns: 1fr; }
            .garage-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
            .shop-grid { grid-template-columns: 1fr; }
        }

        :root {
            color-scheme: dark;
            --surface: rgba(18, 27, 45, .94);
            --surface-raised: #19253a;
            --line: rgba(148, 177, 218, .16);
            --accent: #61d9ce;
            --accent-strong: #35bdb1;
            --text-muted: #9babc2;
            --gold: #f4c56a;
        }

        body {
            padding: clamp(12px, 2.5vw, 32px);
            background:
                radial-gradient(ellipse at 12% 0%, rgba(28, 112, 134, .25), transparent 38%),
                radial-gradient(ellipse at 92% 8%, rgba(98, 61, 147, .2), transparent 34%),
                #090f1b;
            color: #edf3fb;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        }

        .wrapper { max-width: 1440px; }
        .header {
            margin-bottom: 20px;
            padding: clamp(24px, 5vw, 48px) 20px;
            border: 1px solid rgba(127, 219, 220, .25);
            border-radius: 24px;
            background:
                radial-gradient(ellipse at 50% 0%, rgba(75, 211, 194, .19), transparent 58%),
                linear-gradient(135deg, #14283a 0%, #15203a 58%, #201d39 100%);
            box-shadow: 0 18px 50px rgba(0, 0, 0, .25);
        }

        h1 {
            font-size: clamp(1.65rem, 4vw, 3rem);
            letter-spacing: .02em;
            text-shadow: 0 4px 24px rgba(0, 0, 0, .35);
        }

        .subtitle { color: #b8c8db; font-size: .95rem; }
        .header-online {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 18px;
            padding: 8px 13px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: rgba(5, 12, 23, .35);
            color: #d6e2f0;
            font-size: .85rem;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 12px rgba(97, 217, 206, .8);
        }

        .container {
            grid-template-columns: minmax(240px, .95fr) minmax(300px, 1.2fr) minmax(240px, .95fr);
            gap: 16px;
            margin-bottom: 22px;
        }

        .panel, .tab-content {
            border: 1px solid var(--line);
            border-radius: 18px;
            background: linear-gradient(145deg, rgba(23, 34, 53, .97), rgba(15, 23, 39, .97));
            box-shadow: 0 12px 32px rgba(0, 0, 0, .18);
        }

        .panel { padding: clamp(16px, 2vw, 24px); }
        .panel-title, .content-title {
            color: var(--accent);
            border-color: rgba(97, 217, 206, .3);
            letter-spacing: .04em;
        }

        .balance-display {
            color: #f4d58b;
            font-variant-numeric: tabular-nums;
            text-shadow: 0 0 26px rgba(244, 197, 106, .18);
        }

        .info-row { border-color: rgba(148, 177, 218, .1); }
        .info-label, .stat-name { color: var(--text-muted); }
        .info-value, .stat-num { color: var(--accent); }
        .spin-display {
            min-height: 250px;
            border-color: rgba(97, 217, 206, .45);
            border-radius: 16px;
            background: radial-gradient(ellipse at center, #1b2d46, #111a2b);
        }

        .btn, .tab-btn, .shop-btn, .sell-btn, .money-btn {
            border-radius: 12px;
            font-family: inherit;
            letter-spacing: .01em;
            text-transform: none;
        }

        .btn {
            background: linear-gradient(135deg, #28b8ad, #218e96);
            box-shadow: 0 8px 22px rgba(33, 142, 150, .2);
        }

        .btn:hover:not(:disabled) { box-shadow: 0 10px 25px rgba(33, 142, 150, .34); }
        .btn-blue { background: linear-gradient(135deg, #5278d8, #4f5bb4); }
        .btn-gold { background: linear-gradient(135deg, #d7a743, #b9832f); }
        .btn-green { background: linear-gradient(135deg, #25ad89, #18846e); }

        .tabs {
            grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
            gap: 10px;
            margin-bottom: 18px;
        }

        .tab-btn {
            min-height: 48px;
            border: 1px solid var(--line);
            background: rgba(20, 31, 49, .86);
            color: #b7c5d8;
        }

        .tab-btn.active {
            border-color: rgba(97, 217, 206, .55);
            background: linear-gradient(135deg, rgba(37, 153, 154, .9), rgba(57, 91, 152, .92));
            color: #fff;
            box-shadow: 0 8px 20px rgba(38, 147, 153, .18);
        }

        .tab-content { padding: clamp(16px, 2.5vw, 26px); }
        .section-title { color: var(--gold); border-color: rgba(244, 197, 106, .28); }
        .shop-card, .garage-card, .stat-box, .rarity-header, .item {
            border: 1px solid var(--line);
            border-radius: 16px;
            background: linear-gradient(145deg, #19263b, #121c2e);
        }

        .shop-card { padding: 20px; }
        .shop-name { color: var(--gold); }
        .shop-price, .garage-price { color: #f2cf83; }
        .shop-btn, .sell-btn, .money-btn {
            border-radius: 9px;
            background: linear-gradient(135deg, #278f8e, #226c82);
        }

        .shop-card.owned { border-color: rgba(97, 217, 206, .5); }
        .garage-card { border-color: rgba(97, 217, 206, .24); }
        .garage-name, .item-name { color: #88ded7; }
        .stat-box { border-color: rgba(97, 217, 206, .2); }
        .admin-input {
            border: 1px solid var(--line);
            border-radius: 10px;
            background: #0e1726;
            color: #edf3fb;
            font-family: inherit;
        }

        .admin-input:focus { border-color: var(--accent); outline: 2px solid rgba(97, 217, 206, .15); }
        .modal { background: rgba(3, 8, 16, .78); backdrop-filter: blur(10px); }
        .modal-box {
            border: 1px solid rgba(97, 217, 206, .26);
            border-radius: 20px;
            background: #121c2c;
            box-shadow: 0 28px 90px rgba(0, 0, 0, .5);
        }

        .modal-title { color: var(--accent); border-color: rgba(97, 217, 206, .3); }
        .admin-section { border: 1px solid var(--line); border-radius: 14px; background: #121d30; }
        .admin-section-title { color: var(--gold); border-color: rgba(244, 197, 106, .25); }
        .header-meta { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 10px; }
        .admin-launcher {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 36px;
            padding: 7px 13px;
            border: 1px solid rgba(244, 197, 106, .38);
            border-radius: 999px;
            background: rgba(244, 197, 106, .1);
            color: #ffe0a0;
            font-family: inherit;
            font-size: .82rem;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s, border-color .2s, transform .2s;
        }
        .admin-launcher:hover { background: rgba(244, 197, 106, .18); border-color: var(--gold); transform: translateY(-1px); }
        .admin-modal { align-items: flex-start; overflow-y: auto; padding: 12px; }
        .admin-modal-box {
            width: min(820px, 100%);
            max-width: 820px;
            max-height: calc(100dvh - 24px);
            margin: auto;
            padding: 22px;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }
        .admin-modal-header {
            position: sticky;
            top: -22px;
            z-index: 5;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin: -22px -22px 16px;
            padding: 16px 22px 13px;
            border-bottom: 1px solid var(--line);
            background: #121c2c;
        }
        .admin-modal-header .modal-title { margin: 0; padding: 0; border: 0; font-size: 1.2rem; }
        .admin-modal-header .admin-modal-subtitle { margin-top: 5px; color: var(--text-muted); font-size: .8rem; }
        .admin-close-btn {
            position: static !important;
            flex: 0 0 auto;
            width: 36px;
            height: 36px;
            padding: 0;
            border: 1px solid var(--line);
            border-radius: 11px;
            background: rgba(255, 255, 255, .04);
            color: #eaf1fb;
            font-size: 1.15rem;
            cursor: pointer;
        }
        .admin-target-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
        .admin-target-row .admin-input { min-width: 0; margin: 0; }
        .admin-lookup-btn {
            min-width: 112px;
            padding: 0 14px;
            border: 1px solid rgba(97, 217, 206, .34);
            border-radius: 10px;
            background: rgba(97, 217, 206, .12);
            color: #b8f0e9;
            font-family: inherit;
            font-size: .84rem;
            font-weight: 700;
            cursor: pointer;
        }
        .admin-lookup-btn:hover:not(:disabled) { background: rgba(97, 217, 206, .2); }
        .admin-lookup-btn:disabled { opacity: .55; cursor: wait; }
        .admin-target-preview {
            min-height: 22px;
            margin: 7px 1px 14px;
            color: var(--text-muted);
            font-size: .82rem;
            overflow-wrap: anywhere;
        }
        .admin-field-label { display: block; margin: 12px 0 6px; color: #c9d5e5; font-size: .83rem; font-weight: 700; }
        .admin-action-status { min-height: 22px; margin-top: 10px; color: #b9e7d1; font-size: .84rem; }
        .admin-subsection { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
        .admin-subsection .admin-section-title { margin-bottom: 12px; font-size: .95rem; }
        .admin-advanced { margin-top: 14px; border: 1px solid var(--line); border-radius: 14px; background: rgba(12, 21, 35, .56); }
        .admin-advanced > summary { padding: 14px 16px; color: #cbd8e9; font-weight: 700; cursor: pointer; }
        .admin-advanced[open] > summary { border-bottom: 1px solid var(--line); color: var(--gold); }
        .admin-advanced-content { padding: 14px; }
        .admin-advanced-content .admin-section { margin: 0 0 12px; }
        .admin-advanced-content .admin-section:last-child { margin-bottom: 0; }

        .global-rare-banner {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin: 0 auto 14px;
            padding: 12px 16px;
            border: 1px solid rgba(255, 255, 255, .24);
            border-radius: 14px;
            background: linear-gradient(100deg, rgba(44, 35, 78, .98), rgba(31, 51, 79, .98));
            color: #fff;
            text-align: center;
            box-shadow: 0 8px 28px rgba(0, 0, 0, .24);
            animation: bannerDrop .35s ease-out;
        }

        .global-rare-banner[hidden] { display: none; }
        .global-rare-banner[data-rarity="prismatic"] { border-color: rgba(215, 133, 255, .6); }
        .global-rare-banner[data-rarity="secret"] { border-color: rgba(255, 255, 255, .7); background: linear-gradient(100deg, #20212d, #463054); }
